{
  "name": "ampel-graphql",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/src/*.d.ts",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:frontend": "vue-tsc --noEmit -p frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node dist/index.js",
    "dev": "scripts/forward_to_remote -- tsx watch src/index.ts",
    "dev:backend": "tsx watch backend/src/index.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts --host 0.0.0.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "type": "module",
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "bootstrap": "^5.3.8",
    "graphql": "^16.14.2",
    "graphql-scalars": "^2.0.0",
    "mongodb": "^7.6.0",
    "plotly.js-dist-min": "^4.1.1",
    "vue": "^3.5.43",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.0",
    "@types/plotly.js": "^3.0.14",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.13",
    "typescript": "*",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.2",
    "vue-tsc": "^3.3.12"
  },
  "allowScripts": {
    "@apollo/protobufjs@1.2.8": true,
    "fsevents@2.3.3": true,
    "esbuild@0.28.2": true
  }
}
